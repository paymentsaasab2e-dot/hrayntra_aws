{
  "name": "jobportal-backend",
  "version": "1.0.0",
  "description": "Backend API for Job Portal Application",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:setup": "prisma generate && node --watch src/server.js",
    "prestart": "prisma generate",
    "start": "node src/server.js",
    "postinstall": "prisma generate || true",
    "prisma:generate": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test:adzuna": "node --test src/services/adzuna/feed.test.js",
    "test:careerjet": "node --test src/services/careerjet/feed.test.js"
  },
  "keywords": [
    "job-portal",
    "api",
    "express",
    "prisma",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@aws-sdk/client-s3": "^3.758.0",
    "@google/generative-ai": "^0.21.0",
    "@mistralai/mistralai": "^1.14.1",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "bluebird": "^3.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "puppeteer": "^21.11.0",
    "resend": "^3.2.0",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.19.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
