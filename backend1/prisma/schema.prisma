// ============================================================
// SAASA - Candidate Platform Database Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentStatus {
  EMPLOYED
  UNEMPLOYED
  FREELANCING
  STUDENT
  OTHER
}

enum SalaryType {
  MONTHLY
  ANNUAL
  HOURLY
  DAILY
}

enum WorkMode {
  REMOTE
  ON_SITE
  HYBRID
}

enum Proficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  NATIVE
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  ASSESSMENT
  INTERVIEW
  FINAL_DECISION
  SELECTED
  REJECTED
}

enum NotificationUserType {
  job
  application
  interview
  course
  system
  saved_search
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
}

enum CourseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum InterviewRequestStatus {
  PENDING_MATCHING
  MATCHING
  MATCHED
  FINDING_INTERVIEWER
  WAITING_FOR_ACCEPTANCE
  ACCEPTED
  REJECTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum InterviewerApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum InterviewerProfileStatus {
  AVAILABLE
  BUSY
  INACTIVE
}

// ============================================================
// AUTH & VERIFICATION
// ============================================================

model Candidate {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  // Nullable: legacy or email-only signups may not have WhatsApp set yet
  whatsappNumber    String?   @unique
  countryCode       String    @default("+91")
  isVerified        Boolean   @default(false)
  /// bcrypt hash for mobile + password sign-in (null = OTP-only / password not set yet)
  passwordHash      String?
  firstName         String?
  lastName          String?
  email             String?
  phone             String?
  linkedIn          String?
  resumeUrl         String?
  recruiterSkills   String[]  @default([])
  experienceYears   Int?
  currentTitle      String?
  currentCompany    String?
  location          String?
  addressLine       String?
  city              String?
  country           String?
  recruiterStatus   String?
  source            String?
  rating            Int?
  availability      String?
  noticePeriod      String?
  hotlist           Boolean   @default(false)
  avatar            String?
  designation       String?
  expectedSalary    Float?
  currentSalary     Float?
  recruiterEducation String?
  certificationsList String[] @default([])
  recruiterLanguages String[] @default([])
  portfolio         String?
  website           String?
  recruiterNotes    String?
  cvSummary         String?
  cvEducationEntries Json?
  cvWorkExperienceEntries Json?
  cvPortfolioLinks  Json?
  preferredLocation String?
  assignedJobs      String[]  @default([])
  stage             String?
  lastActivity      DateTime?
  createdAt         DateTime? @default(now())
  updatedAt         DateTime? @updatedAt

  // Gamified token wallet (LMS / AI services)
  tokenBalance         Int       @default(0)
  freeTokensGrantedAt  DateTime?

  // Relations
  otpVerifications  OtpVerification[]
  profile           CandidateProfile?
  resume            Resume?
  resumeVersions    ResumeVersion[]
  educations        Education[]
  workExperiences   WorkExperience[]
  skills            CandidateSkill[]
  languages         CandidateLanguage[]
  careerPreferences CareerPreferences?
  summary           CandidateSummary?
  gapExplanation    CandidateGapExplanation?
  internship        CandidateInternship?
  portfolioLinks    CandidatePortfolioLinks?
  project           CandidateProject?
  academicAchievement CandidateAcademicAchievement?
  competitiveExam   CandidateCompetitiveExam?
  certifications    CandidateCertification[]
  accomplishments   CandidateAccomplishment[]
  visaWorkAuthorization CandidateVisaWorkAuthorization?
  vaccination       CandidateVaccination?
  applications      Application[]
  savedJobs         SavedJob[]
  notifications     Notification[]
  dashboardStats    DashboardStats?
  courseEnrollments CourseEnrollment[]
  recruiterMatches  Match[]
  pipelineEntries   PipelineEntry[]
  tokenTransactions TokenTransaction[]

  lmsEnrollments         LmsEnrollment[]         @relation("LmsEnrollments")
  lmsQuizAttempts        LmsQuizAttempt[]        @relation("LmsQuizAttempts")
  lmsNotes               LmsNote[]               @relation("LmsNotes")
  lmsEventRegistrations  LmsEventRegistration[]  @relation("LmsEventRegistrations")
  lmsResumeDraft         LmsResumeDraft?         @relation("LmsResumeDraft")
  lmsResumeRoleVersions  LmsResumeRoleVersion[]  @relation("LmsResumeRoleVersions")
  lmsCareerPath          LmsCareerPath?          @relation("LmsCareerPath")
  lmsInterviewSessions   LmsInterviewPrepSession[] @relation("LmsInterviewSessions")
  lmsInterviewSets       LmsInterviewSet[]       @relation("LmsInterviewSets")
  interviewRequests      InterviewRequest[]      @relation("CandidateInterviewRequests")
  interviewerApplications InterviewerApplication[] @relation("CandidateInterviewerApplications")
  interviewerProfile     InterviewerProfile?     @relation("CandidateInterviewerProfile")
  assignedInterviewRequests InterviewRequest[]   @relation("AssignedInterviewerRequests")
  globalAiInterviews     GlobalAiInterview[]     @relation("CandidateGlobalAiInterviews")

  cvAnalysis        CvAnalysis?
  settings          Settings?
  sessions          Session[]

  @@index([email])
  @@index([firstName, lastName])
  @@map("candidates")
}

// ============================================================
// TOKEN WALLET LEDGER
// ============================================================

model TokenTransaction {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  candidateId  String   @db.ObjectId
  type         String   // GRANT | PURCHASE | SPEND
  amount       Int      // positive for credit, positive for spend (type distinguishes)
  balanceAfter Int
  service      String?  // e.g. "lms.resume.ai-improve"
  packageId    String?
  reference    String?  // mock payment reference
  description  String?
  createdAt    DateTime @default(now())

  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([createdAt])
  @@map("token_transactions")
}

model OtpVerification {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId String    @db.ObjectId
  otp         String
  status      OtpStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("otp_verifications")
}

model Settings {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  candidateId         String   @unique @db.ObjectId

  // Notification settings
  emailNotifications  Boolean  @default(true)
  smsNotifications    Boolean  @default(false)
  whatsappNotifications Boolean @default(false)
  jobAlerts           Boolean  @default(true)

  // Privacy settings
  profileVisibility   String   @default("Recruiters only")
  dataSharing         Boolean  @default(false)

  // Preferences
  language            String   @default("English")
  timezone            String   @default("Asia/Kolkata (UTC+05:30)")
  theme               String   @default("System")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Session {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId       String    @db.ObjectId
  token             String    @unique
  userAgent         String?
  ipAddress         String?
  /// When the session/login started (mirrors createdAt for clarity in analytics).
  loginAt           DateTime  @default(now())
  logoutAt          DateTime?
  /// Wall-clock session length in ms (logoutAt - loginAt) when closed.
  durationMs        Int?
  deviceType        String?   // desktop | mobile | tablet
  browser           String?
  operatingSystem   String?
  country           String?
  state             String?
  city              String?
  timezone          String?
  isActive          Boolean?  @default(true)
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())

  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([loginAt])
  @@index([isActive])
  @@map("sessions")
}

// ============================================================
// PERSONAL PROFILE
// ============================================================

model CandidateProfile {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  candidateId         String          @unique @db.ObjectId
  fullName            String
  email               String
  isEmailVerified     Boolean         @default(false)
  phoneNumber         String?
  alternatePhone      String?
  profilePhotoUrl     String?
  gender              Gender?
  dateOfBirth         DateTime?
  maritalStatus       MaritalStatus?
  address             String?
  city                String?
  country             String?
  nationality         String?
  passportNumber      String?
  linkedinUrl         String?
  employmentStatus    EmploymentStatus?
  profileCompleteness Int             @default(0)
  skillsAdditionalNotes String?      // Additional notes for skills section
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  candidate           Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

// ============================================================
// RESUME
// ============================================================

model Resume {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  candidateId  String   @unique @db.ObjectId
  fileName     String
  fileUrl      String
  fileSize     Int?     // in bytes
  mimeType     String?
  atsScore     Int?     // 0-100
  aiAnalyzed   Boolean  @default(false)
  resumeJson   Json?    // Structured resume data in JSON format
  resumeHtml   String?  // HTML content for WYSIWYG editor
  templateId   String?  // Template identifier for consistent rendering
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]

  @@map("resumes")
}

// ============================================================
// RESUME VERSIONS
// ============================================================

model ResumeVersion {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  candidateId  String   @db.ObjectId
  resumeId     String   @db.ObjectId
  resumeJson   Json?    // Snapshot of resume JSON at this version
  resumeHtml   String?  // Snapshot of resume HTML at this version
  templateId   String?  // Template identifier
  createdAt    DateTime @default(now())

  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_versions")
  @@index([candidateId])
  @@index([resumeId])
}

// ============================================================
// EDUCATION
// ============================================================

model Education {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId    String    @db.ObjectId
  educationLevel String?   // High School, Diploma, Bachelor's, Master's, etc.
  degree         String
  institution    String
  institutionLocation String? // City / area shown after institution name
  specialization String?   // Field of Study / Major
  startYear      Int
  startMonth     Int?
  endYear        Int?
  endMonth       Int?
  isOngoing      Boolean   @default(false)
  grade          String?
  modeOfStudy    String?   // Full-time, Part-time, Online, etc.
  courseDuration String?   // e.g., "3 years"
  description    String?
  documents      String[]  @default([]) // URLs to uploaded certificate/document files
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("educations")
}

// ============================================================
// SKILLS
// ============================================================

model Skill {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  name             String           @unique
  category         String?
  createdAt        DateTime         @default(now())

  candidateSkills  CandidateSkill[]
  jobSkills        JobSkill[]

  @@map("skills")
}

model CandidateSkill {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  candidateId   String      @db.ObjectId
  skillId       String      @db.ObjectId
  proficiency   Proficiency @default(INTERMEDIATE)
  isAiSuggested Boolean     @default(false)
  yearsOfExp    Float?
  createdAt     DateTime    @default(now())

  candidate     Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill         Skill       @relation(fields: [skillId], references: [id])

  @@unique([candidateId, skillId])
  @@map("candidate_skills")
}

// ============================================================
// LANGUAGES
// ============================================================

model CandidateLanguage {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  candidateId String      @db.ObjectId
  name        String
  proficiency Proficiency @default(INTERMEDIATE)
  canSpeak    Boolean     @default(false)
  canRead     Boolean     @default(false)
  canWrite    Boolean     @default(false)
  documents   String[]    @default([]) // URLs to uploaded certificate/document files
  createdAt   DateTime    @default(now())

  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, name])
  @@map("candidate_languages")
}

// ============================================================
// WORK EXPERIENCE
// ============================================================

model WorkExperience {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId      String    @db.ObjectId
  jobTitle         String
  company          String
  workLocation     String?
  workMode         WorkMode?
  startDate        DateTime
  endDate          DateTime?
  isCurrentJob     Boolean   @default(false)
  responsibilities String?   // Rich text / markdown
  industry         String?
  employmentType   EmploymentType?
  numberOfReportees String?
  companyProfile   String?
  companyTurnover  String?
  achievements     String?
  workSkills       String[]  @default([])
  documents        String[]  @default([]) // URLs to uploaded certificate/document files
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("work_experiences")
}

// ============================================================
// CAREER PREFERENCES
// ============================================================

model CareerPreferences {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId         String    @unique @db.ObjectId

  // Current
  currentCurrency     String?   @default("USD")
  currentSalaryType   SalaryType?
  currentSalary       Float?
  currentLocation     String?
  currentBenefits     String[]  @default([])

  // Preferred - Role & Domain
  preferredRoles      String[]  @default([])
  preferredIndustry   String?
  functionalArea      String?
  
  // Preferred - Job Type & Work Mode
  jobTypes            String[]  @default([])
  preferredWorkMode   WorkMode?
  
  // Preferred - Location
  preferredLocations  String[]  @default([])
  relocationPreference String?
  
  // Preferred - Salary
  preferredCurrency   String?   @default("USD")
  preferredSalaryType SalaryType?
  preferredSalary     Float?
  preferredBenefits   String[]  @default([])

  // Availability
  availabilityToStart String?
  noticePeriodDays    Int?
  noticePeriod        String?
  openToRelocation    Boolean   @default(false)
  
  // Passport numbers by location
  passportNumbersByLocation Json?
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("career_preferences")
}

model CandidateSummary {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId String    @unique @db.ObjectId
  summaryText String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_summaries")
}

model CandidateGapExplanation {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId      String    @unique @db.ObjectId
  gapCategory      String
  reasonForGap     String
  gapDuration      String
  selectedSkills   String[]  @default([])
  coursesText      String?
  preferredSupport Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_gap_explanations")
}

model CandidateInternship {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId      String    @unique @db.ObjectId
  internshipTitle  String
  companyName      String
  internshipType   String?
  domainDepartment String?
  startDate        DateTime?
  endDate          DateTime?
  currentlyWorking Boolean   @default(false)
  location         String?
  workMode         String?
  responsibilities String?
  learnings        String?
  skills           String[]  @default([])
  documents        String[]  @default([]) // URLs to uploaded certificate/document files
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_internships")
}

model CandidatePortfolioLinks {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId String    @unique @db.ObjectId
  links       Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_portfolio_links")
}

// ============================================================
// PROJECTS & ACHIEVEMENTS
// ============================================================

model CandidateProject {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId        String    @unique @db.ObjectId
  projectTitle       String
  projectType        String
  organizationClient String?
  currentlyWorking   Boolean   @default(false)
  startDate          DateTime?
  endDate            DateTime?
  projectDescription String?
  responsibilities   String?
  technologies       String[]  @default([])
  projectOutcome     String?
  projectLink        String?
  documents          String[]  @default([]) // URLs to uploaded certificate/document files
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  candidate          Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_projects")
}

model CandidateAcademicAchievement {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId      String    @unique @db.ObjectId
  achievementTitle String
  awardedBy        String
  yearReceived     String
  categoryType     String?
  description      String?
  documents        String[]  @default([]) // URLs to uploaded certificate/document files
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_academic_achievements")
}

model CandidateCompetitiveExam {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId     String    @unique @db.ObjectId
  examName        String
  yearTaken       String
  resultStatus    String
  scoreMarks      String?
  scoreType       String?
  validUntil      String?
  additionalNotes String?
  documents       String[]  @default([]) // URLs to uploaded certificate/document files
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_competitive_exams")
}

model CandidateCertification {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId         String    @db.ObjectId
  certificationName   String
  issuingOrganization String
  issueDate           String
  expiryDate          String?
  doesNotExpire       Boolean   @default(false)
  credentialId        String?
  credentialUrl       String?
  certificateFile     String?
  documents           String[]  @default([]) // URLs to uploaded certificate/document files
  
  description         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_certifications")
}

model CandidateAccomplishment {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId        String    @db.ObjectId
  title              String
  category           String
  organization       String?
  achievementDate    String
  description        String?
  supportingDocument String?
  documents          String[]  @default([]) // URLs to uploaded supporting documents
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  candidate          Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_accomplishments")
}

model CandidateVisaWorkAuthorization {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId            String    @unique @db.ObjectId
  selectedDestination    String?
  visaDetailsInitial     Json?
  visaDetailsExpected    Json?
  visaWorkpermitRequired String?
  openForAll             Boolean   @default(false)
  additionalRemarks      String?
  visaEntries            Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  candidate              Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_visa_work_authorizations")
}

model CandidateVaccination {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  candidateId         String    @unique @db.ObjectId
  vaccinationStatus   String
  vaccineType         String?
  lastVaccinationDate String?
  validityMonth       String?
  validityYear        String?
  certificate         String?
  documents           String[]  @default([])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_vaccinations")
}

// ============================================================
// JOBS
// ============================================================

model Company {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  logoUrl     String?
  website     String?
  industry    String?
  overview    String?
  location    String?
  createdAt   DateTime @default(now())

  jobs        Job[]

  @@map("companies")
}

// ── CLIENT (shared with backendphase2) ──
// backendphase2 stores clients in the `clients` collection.
// We add a compatible model so backend1 can read jobs created from backendphase2.
model Client {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  companyName   String
  industry      String?
  website       String?
  logo          String?
  location      String?
  status        String?
  assignedToId  String?   @db.ObjectId

  jobs Job[]

  @@map("clients")
}

model Job {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  // backend1's original schema uses `companyId` (companies collection).
  // When jobs are created from backendphase2, they usually include `clientId` (clients collection).
  companyId        String?        @db.ObjectId
  title            String
  location         String?
  city             String?
  country          String?
  state            String?

  // Phase 2 CRM fields (shared Mongo `jobs` collection)
  nationality              String?
  forecastRevenue          String?
  videoMediaLink           String?
  languages                Json? // [{ language, proficiency }]
  expectedClosureDate      DateTime?
  jdFileName               String?

  clientId              String?        @db.ObjectId
  description           String?
  overview              String?
  openings              Int?           @default(1)
  keyResponsibilities    String[]       @default([])
  requirements           String[]       @default([])
  candidateRequirements  String[]       @default([])
  preferredSkills       String[]       @default([])
  experienceRequired    String?
  education              String?
  benefits               String[]       @default([])
  hiringManager         String?
  hiringManagerId       String?        @db.ObjectId
  salary                 Json?
  type                   String?
  priority               String?
  department             String?
  jobCategory            String?
  jobLocationType        String?

  // backend1 legacy salary fields (still used by some existing data)
  salaryMin        Float?
  salaryMax        Float?
  salaryCurrency   String?        @default("USD")
  salaryType       SalaryType?    @default(ANNUAL)
  experienceLevel  String?        // e.g. "Entry-Mid", "Senior", "5+ Years"
  // The Job collection is shared with Phase 2, which writes free-form display
  // strings (e.g. "Remote", "On-site", "Full-Time") rather than the strict enum
  // tokens. Keep these as nullable Strings so Prisma never fails to deserialize
  // a record from the shared collection. The portal/controller normalizes
  // incoming filter values before matching.
  employmentType   String?        @default("FULL_TIME")
  workMode         String?        @default("ON_SITE")
  industry         String?
  aboutRole        String?
  responsibilities String?
  visaSponsorship  Boolean        @default(false)
  isActive         Boolean        @default(true)
  postedAt         DateTime?      @default(now())
  // backendphase2 (CRM) writes `createdAt` on every new job. Surfacing the field in
  // backend1's Prisma client lets the candidate-side pipeline read the real creation
  // timestamp for jobs that don't carry `postedAt`.
  createdAt         DateTime?
  postedDate        DateTime?
  updatedAt         DateTime       @updatedAt

  company          Company?       @relation(fields: [companyId], references: [id])
  client           Client?        @relation(fields: [clientId], references: [id])

  // Legacy join-table relation (not used by the job-listing endpoint we updated).
  jobSkills       JobSkill[]

  // backendphase2 stores skills as a string array on the job document.
  // backend1 originally used a JobSkill join table; we add a compatible scalar field.
  skills           String[]      @default([])

  // Mirrored from backendphase2 / job portal sync (custom apply-form logo stored as HTTPS URL or preset tokens)
  applicationFormEnabled  Boolean?
  applicationFormLogo     String?
  applicationFormQuestions String[] @default([])
  applicationFormNote      String?
  /// Mirrored from Phase 2 — attached pre-screen assessments (MCQ, essay, etc.)
  preScreenAssessments     Json?

  // Origin tenant DB this job belongs to (e.g. "rus01", "agency-acme"). Written by
  // backendphase2 when the CRM mirrors a job to the portal DB. Multi-agency safe:
  // the apply webhook routes the new Application/Match into the correct tenant DB.
  tenantDbName             String?

  /// When false, client/company name is hidden on candidate-facing job listings and apply pages.
  showClientNamePublicly   Boolean?  @default(true)
  /// Per-field public visibility mirrored from Phase 2 CRM.
  publicFieldVisibility    Json?
  aboutCompany             String?
  recruiterProfile         Json?

  applications     Application[]
  savedJobs        SavedJob[]
  aiJobMatches     AiJobMatch[]
  recruiterPipelineStages PipelineStage[]
  recruiterMatches Match[]

  @@index([title])
  @@index([location])
  @@index([industry])
  @@index([type])
  @@index([postedAt])
  @@index([isActive])
  @@map("jobs")
}

model PipelineStage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  order     Int
  color     String?
  jobId     String   @db.ObjectId
