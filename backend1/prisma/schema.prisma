// ============================================================

model CandidateCommon {
  id                      String    @id @map("_id") @db.ObjectId
  candidateId             String    @unique @db.ObjectId
  isVerified              Boolean   @default(false)
  firstName               String?
  lastName                String?
  email                   String?
  phone                   String?
  linkedIn                String?
  resumeUrl               String?
  skills                  String[]  @default([])
  recruiterSkills         String[]  @default([])
  experience              Int?
  experienceYears         Int?
  currentTitle            String?
  currentCompany          String?
  location                String?
  city                    String?
  country                 String?
  designation             String?
  cvSummary               String?
  notes                   String?
  recruiterNotes          String?
  certifications          String[]  @default([])
  certificationsList      String[]  @default([])
  cvEducationEntries      Json?
  cvWorkExperienceEntries Json?
  cvPortfolioLinks        Json?
  profileSnapshot         Json?
  profilePhotoUrl         String?
  gender                  String?
  middleName              String?
  whatsappNumber          String?
  addressLine             String?
  state                   String?
  zipCode                 String?
  dateOfBirth             String?
  languagesDetail         Json?
  recruiterLanguages      String[]  @default([])
  careerPreferences       Json?
  resumeFileName          String?
  resumeMimeType          String?
  resumeAtsScore          Int?
  noticePeriod            String?
  availability            String?
  assignedJobs            String[]  @default([])
  matchJobIds             String[]  @default([])
  stage                   String?
  source                  String?   @default("phase1")
  lastLoginAt             DateTime?
  syncedAt                DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([assignedJobs])
  @@index([matchJobIds])
  @@index([isVerified])
  @@map("candidate_commons")
}

// ============================================================
// GLOBAL AI MOCK INTERVIEW
// ============================================================

model GlobalAiInterview {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  candidateId String? @db.ObjectId
  topic     String
  createdAt DateTime @default(now())
  messages  GlobalAiInterviewMessage[]
  report    Json?

  candidate Candidate? @relation("CandidateGlobalAiInterviews", fields: [candidateId], references: [id])
  @@map("global_ai_interviews")
}

model GlobalAiInterviewMessage {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  interviewId    String   @db.ObjectId
  role           String   // 'ai' or 'candidate'
  text           String
  score          Float?
  timestamp      DateTime @default(now())

  interview      GlobalAiInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("global_ai_interview_messages")
}

// ============================================================
// EMPLOYER DEMO REQUESTS (marketing site)
// ============================================================

model EmployerDemoRequest {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  email            String
  otp              String?
  otpStatus        OtpStatus @default(PENDING)
  otpExpiresAt     DateTime?
  emailVerifiedAt  DateTime?
  fullName         String
  countryCode      String
  dialCode         String
  phoneNumber      String
  companySize      String
  organizationName String
  organizationType String    @default("agency")
  outcome          String?
  requestKind      String    @default("demo")
  trialProvisioned Boolean   @default(false)
  trialTenantDbName String?
  trialLoginId     String?
  trialStartsAt    String?
  trialEndsAt      String?
  trialLoginUrl    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([email])
  @@index([otpStatus])
  @@map("employer_demo_requests")
}

// ============================================================
// SYSTEM AUDIT LOGS (admin / privileged actions)
// ============================================================

model SystemAuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  /// e.g. candidate.hard_delete | job.bulk_delete | audit.hq_release
  action      String
  entityType  String
  entityId    String?
  actorId     String?
  actorLabel  String?
  actorRole   String?
  source      String?
  status      String   @default("success")
  ipAddress   String?
  userAgent   String?
  /// Free-form details (before/after, counts, HQ package ids, etc.)
  metadata    Json?
  capturedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([entityType])
  @@index([actorId])
  @@index([capturedAt])
  @@map("system_audit_logs")
}

// ============================================================
// OFFICE GOSSIPS — platform catalog + reference checks (Mongo)
// Personalized identity / feed / chat extras live on UserOfficeGossipProfile
// ============================================================

/// Platform-wide OG entities (communities, posts, ref checks, DMs, follows).
model OfficeGossipEntity {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Client business id (stable upsert key with kind).
  entityId    String
  /// community | company_page | post | comment | reference_check | dm | company_follow | people_follow
  kind        String
  payload     Json
  ownerUserId String?
  status      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kind, entityId])
  @@index([kind])
  @@index([ownerUserId])
  @@index([status])
  @@index([updatedAt])
  @@map("office_gossip_entities")
}

/// Per-user OG layer linked to candidate userId (like behaviour profile).
model UserOfficeGossipProfile {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @unique
  /// Gossip identity (anon flag, username, ref-check fees, etc.)
  identity     Json?
  /// Personalised feed / chat events for this user
  feedEvents   Json?
  /// Extra personal prefs / local-only style meta
  personalMeta Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
  @@map("user_office_gossip_profiles")
}

model OfficeGossipMeta {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     Json?
  updatedAt DateTime @updatedAt

  @@map("office_gossip_meta")
}

