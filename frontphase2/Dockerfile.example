# Example production image for frontphase2 (Next.js).
# Build from this directory:
#   docker build -f Dockerfile.example -t frontphase2 .
#
# OOM during `next build` is common with SuperDoc — raise Node heap and set DOCKER=1.

FROM node:20-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-bookworm-slim AS builder
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV DOCKER=1
ENV NODE_OPTIONS=--max-old-space-size=6144
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3001
ENV HOSTNAME=0.0.0.0
ENV NODE_OPTIONS=--max-old-space-size=2048
# Headless LibreOffice converts DOCX→PDF when Microsoft Word is unavailable.
# Metric-compatible fonts (Carlito≈Calibri, Caladea≈Cambria, Liberation≈Arial/Times)
# are required or multi-column resumes reflow badly.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    libreoffice-writer-nogui \
    fontconfig \
    fonts-dejavu-core \
    fonts-liberation \
    fonts-liberation2 \
    fonts-crosextra-carlito \
    fonts-crosextra-caladea \
  && fc-cache -f \
  && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/package.json ./
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
EXPOSE 3001
CMD ["npm", "run", "start"]
