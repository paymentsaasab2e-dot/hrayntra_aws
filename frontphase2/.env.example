NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1
NEXT_PUBLIC_API_BASE=http://localhost:5001

# Headquarters `/hq` UI — comma-separated emails allowed (default: admin@gmail.com if unset)
NEXT_PUBLIC_HQ_ALLOWED_EMAILS=admin@gmail.com

# Public backend origin for “register this redirect URI” hints (production)
NEXT_PUBLIC_BACKEND_PUBLIC_URL=

# Backend PDF proxy (same as API base, must include /api/v1)
BACKEND_INTERNAL_URL=http://localhost:5001/api/v1

# Optional fallback if backend is down (same Cloudinary vars as backend — never commit real secrets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bulk CV upload: parallel parse+create workers (1–6, default 3). Higher = faster batches, more API load.
# Safe on $5 plan — fewer 429s
NEXT_PUBLIC_BULK_CV_CONCURRENCY=3

# Slightly faster — use only if OpenAI dashboard shows headroom
# NEXT_PUBLIC_BULK_CV_CONCURRENCY=4
