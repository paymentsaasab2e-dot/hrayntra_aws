# Local dev: mongodb://127.0.0.1:27017/hrms
# Atlas example (include database name /hrms before ?):
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/hrms?appName=Cluster0"
JWT_SECRET="change-me-in-production"
PORT=5000

# Resend — welcome email when admin creates a user
RESEND_API_KEY=""
RESEND_FROM_EMAIL="HRMS Yantra <otp@yourdomain.com>"
RESEND_TEMPLATE_AUTH_OTP=""
HRMS_APP_URL="http://localhost:3000"
