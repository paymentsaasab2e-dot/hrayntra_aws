model SuccessionCandidate {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId            String         @db.ObjectId
  planId              String         @db.ObjectId
  plan                SuccessionPlan @relation(fields: [planId], references: [id])
  candidateEmployeeId String         @db.ObjectId
  candidateEmployee   Employee       @relation("SuccessorCandidate", fields: [candidateEmployeeId], references: [id])
