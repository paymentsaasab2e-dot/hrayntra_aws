model JobRequisition {
  id                         String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId                   String   @db.ObjectId
  tenant                     Tenant   @relation(fields: [tenantId], references: [id])
  requisitionNumber          String   // e.g. "REQ-2026-001"
  title                      String   // e.g. "Senior Full-Stack Engineer"
  department                 String   // "Engineering"
  numberOfOpenings           Int      @default(1)
  budgetedMinCtc             Float
  budgetedMaxCtc             Float
  employmentType             String   @default("FULL_TIME")
  justification              String?
  status                     String   @default("SUBMITTED") // "DRAFT", "APPROVED", "BUDGET_EXCEPTION_REQUIRED", "REJECTED", "FILLED", "CANCELLED"
  budgetExceeded             Boolean  @default(false)
  currentDepartmentHeadcount Int      // Snapshot of actual active employees at requisition time
  approvedDepartmentBudget   Int      // Snapshot of approved budget cap at requisition time
  raisedByUserId             String?  @db.ObjectId
  approvedByUserId           String?  @db.ObjectId
  approvalNotes              String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([tenantId, requisitionNumber])
  @@index([tenantId, department, status])
}






