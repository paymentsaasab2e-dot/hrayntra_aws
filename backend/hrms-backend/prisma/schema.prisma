model SuccessionPlan {
  id                  String                @id @default(auto()) @map("_id") @db.ObjectId
  tenantId            String                @db.ObjectId
  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  positionTitle       String                // e.g. "VP of Engineering", "Head of Sales"
  department          String
  currentIncumbentId  String?               @db.ObjectId
  currentIncumbent    Employee?             @relation("Incumbent", fields: [currentIncumbentId], references: [id])
  criticality         String                @default("HIGH") // "CRITICAL", "HIGH", "MEDIUM"
  targetReadinessDate DateTime?
  status              String                @default("ACTIVE") // "ACTIVE", "ARCHIVED"
  candidates          SuccessionCandidate[]
