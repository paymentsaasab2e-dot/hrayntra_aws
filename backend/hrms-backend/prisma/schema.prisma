// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_OWNER
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum UserAccountStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
}

model User {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  email       String            @unique
  password    String
  role        Role              @default(EMPLOYEE)
  displayName String?
  permissions Json?
  status      UserAccountStatus @default(ACTIVE)
  tenantId    String?           @db.ObjectId
  tenant      Tenant?           @relation(fields: [tenantId], references: [id])
  orgUnitId   String?           @db.ObjectId
  orgUnit     OrgUnit?          @relation(fields: [orgUnitId], references: [id])
  employees   Employee[]
  delegatedApprovals  ApprovalDelegation[] @relation("Delegator")
  receivedDelegations ApprovalDelegation[] @relation("Delegatee")
  complianceAcceptances ComplianceAcceptance[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Employee {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String         @unique // Custom ID like EMP001
  firstName       String
  lastName        String
  userId          String?        @db.ObjectId
  user            User?          @relation(fields: [userId], references: [id])
  email           String         @unique
  phone           String?
  designation     String
  department      String
  joiningDate     DateTime
  dateOfBirth     DateTime?
  avatar          String?
  status          EmployeeStatus @default(ACTIVE)
  
  // Attendance and Leave relations
  attendance         Attendance[]
  leaves             Leave[]
  tasks              Task[]
  assetAllocations   AssetAllocation[]
  documents          Document[]
  performanceReviews PerformanceReview[]
  
  // New fields
  locationId      String?        @db.ObjectId
  location        WorkLocation?  @relation(fields: [locationId], references: [id])
  orgUnitId       String?        @db.ObjectId
  orgUnit         OrgUnit?       @relation(fields: [orgUnitId], references: [id])
  tenantId        String?        @db.ObjectId
  tenant          Tenant?        @relation(fields: [tenantId], references: [id])
  reportsToUserId String?        @db.ObjectId
  totalLeaves     Int            @default(12)
  probationEndDate DateTime?
  separationRequests SeparationRequest[]
  compensation    EmployeeCompensation?
  fieldVisitAssignments FieldVisitAssignment[]
  fieldVisitPings       FieldVisitLocationPing[]
  changeRequests        EmployeeChangeRequest[]
  employmentHistory     EmploymentHistory[]
  customFields          Json?          // Dynamic attributes e.g. { blood_group: "O+", seat_number: "2A" }
  emergencyContacts     EmployeeEmergencyContact[]
  dependents            EmployeeDependent[]
  nominees              EmployeeNominee[]
  leaveAccrualLedgers   LeaveAccrualLedger[]
  leaveEncashmentRequests LeaveEncashmentRequest[]
  lopReversalAdjustments  LopReversalAdjustment[]
  complianceAcceptances ComplianceAcceptance[]
  trainingAssignments   TrainingAssignment[]
  incrementRecommendations EmployeeIncrementRecommendation[]
  talentAssessments       TalentAssessment[]
  employeeSkills          EmployeeSkill[]
  incumbentSuccessionPlans SuccessionPlan[]               @relation("Incumbent")
  successionCandidateProfiles SuccessionCandidate[]       @relation("SuccessorCandidate")
  gender          String?        // MALE, FEMALE, OTHER (for statutory maternity/paternity validation)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model WorkLocation {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  address      String?
  lat          Float
  lng          Float
  radiusMeters Int        @default(100)
  isActive     Boolean    @default(true)
  usage        LocationUsage @default(BOTH)
  tenantId     String?    @db.ObjectId
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  orgUnitId    String?    @db.ObjectId
  orgUnit      OrgUnit?   @relation(fields: [orgUnitId], references: [id])
  employees    Employee[]
  fieldVisitAssignments FieldVisitAssignment[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum LocationUsage {
  ATTENDANCE
  VISITS
  BOTH
}

enum OrgUnitStatus {
  ACTIVE
  PENDING_HQ_APPROVAL
}

enum ApprovalRequestType {
  USER_ONBOARDING
  LEAVE
  ORG_SETTINGS
  EXIT
  EMPLOYEE_CHANGE
}

enum PolicyDocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PolicyCategory {
  LEAVE_ATTENDANCE
}

enum SeparationStatus {
  DRAFT
  SUBMITTED
  MANAGER_APPROVED
  ACCEPTED
  IN_NOTICE
  CLEARANCE_PENDING
  COMPLETED
  REJECTED
  WITHDRAWN
}

enum SeparationExitType {
  RESIGNATION
  TERMINATION
  RETIREMENT
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TenantPackageKey {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model Tenant {
  id               String                 @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String                 @unique
  status           TenantStatus           @default(ACTIVE)
  packageKey       TenantPackageKey       @default(STARTER)
  maxUsers         Int                    @default(25)
  packagePermissions Json?
  provisionedAdminUserId    String?  @db.ObjectId
  provisionedAdminEmail     String?
  provisionedAdminPassword  String?
  /// When true, Operations → Users table shows an extra Location column
  showUsersLocationColumn Boolean @default(false)
  hierarchyLevels  TenantHierarchyLevel[]
  approvalLevels   TenantApprovalLevel[]
  orgUnits         OrgUnit[]
  users            User[]
  employees        Employee[]
  workLocations    WorkLocation[]
  holidays         Holiday[]
  assets           Asset[]
  documents        Document[]
  projects         Project[]
  tasks            Task[]
  approvalRequests ApprovalRequest[]
  policyDocuments  PolicyDocument[]
  separationRequests SeparationRequest[]
  payrollComplianceProfiles PayrollComplianceProfile[]
  employeeCompensations EmployeeCompensation[]
  onboardingHires OnboardingHire[]
  employeeChangeRequests EmployeeChangeRequest[]
  employmentHistories    EmploymentHistory[]
  customFieldDefinitions CustomFieldDefinition[]
  emergencyContacts      EmployeeEmergencyContact[]
  dependents             EmployeeDependent[]
  nominees               EmployeeNominee[]
  celebrationWishes      CelebrationWish[]
  hrTemplates            HrTemplate[]
  leaveAccrualPlans      LeaveAccrualPlan[]
  leaveAccrualLedgers    LeaveAccrualLedger[]
  leaveEncashmentRequests LeaveEncashmentRequest[]
  approvalDelegations    ApprovalDelegation[]
  attendanceImportBatches AttendanceImportBatch[]
  lopReversalAdjustments LopReversalAdjustment[]
  complianceDocuments    ComplianceDocument[]
  complianceAcceptances  ComplianceAcceptance[]
  trainingCourses        TrainingCourse[]
  trainingAssignments    TrainingAssignment[]
  compensationCycles     CompensationCycle[]
  departmentBudgetPools  DepartmentBudgetPool[]
  talentAssessments      TalentAssessment[]
  skillDefinitions       SkillDefinition[]
  successionPlans        SuccessionPlan[]
  headcountPlans         HeadcountPlan[]
  jobRequisitions        JobRequisition[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model TenantHierarchyLevel {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String  @db.ObjectId
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  levelOrder  Int
  code        String
  displayName String
  isLeaf      Boolean @default(false)
}

model TenantApprovalLevel {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String @db.ObjectId
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  level       Int
  displayName String
}

model OrgUnit {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String         @db.ObjectId
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  parentId        String?        @db.ObjectId
  parent          OrgUnit?       @relation("OrgTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        OrgUnit[]      @relation("OrgTree")
  levelOrder      Int
  name            String
  path            String
  isLeaf          Boolean        @default(false)
  status          OrgUnitStatus  @default(ACTIVE)
  createdByUserId String?        @db.ObjectId
  employees       Employee[]
  users           User[]
  workLocations   WorkLocation[]
  approvalRequests ApprovalRequest[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ApprovalRequest {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String                @db.ObjectId
  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  type         ApprovalRequestType
  status       ApprovalRequestStatus @default(PENDING)
  currentLevel Int                   @default(1)
  maxLevel     Int                   @default(1)
  payload      Json
  requesterId  String?               @db.ObjectId
  orgUnitId    String?               @db.ObjectId
  orgUnit      OrgUnit?              @relation(fields: [orgUnitId], references: [id])
  referenceId  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

enum AttendancePunchStatus {
  ACCEPTED
  REJECTED
}

model Attendance {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String                @db.ObjectId
  employee        Employee              @relation(fields: [employeeId], references: [id])
  date            DateTime
  checkInTime     DateTime
  checkOutTime    DateTime?
  status          AttendanceStatus      @default(PRESENT)
  lat             Float?
  lng             Float?
  distanceMeters  Float?
  punchStatus     AttendancePunchStatus @default(ACCEPTED)
  isActive        Boolean               @default(true)
  rejectionReason String?
  punchMode       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALFDAY
}

model Leave {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String      @db.ObjectId
  employee    Employee    @relation(fields: [employeeId], references: [id])
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      LeaveStatus @default(PENDING)
  appliedAt   DateTime    @default(now())
  processedBy String?     @db.ObjectId
  processedAt DateTime?
  adminRemark String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  MATERNITY
  PATERNITY
  LOSS_OF_PAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Holiday {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  date        DateTime
  type        String?  // e.g. Public Holiday
  description String?
  isActive    Boolean  @default(true)
  tenantId    String?  @db.ObjectId
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, date])
}

model Project {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String?
  projectHeadId String?  @db.ObjectId
  status        String   @default("ACTIVE")
  tenantId      String?  @db.ObjectId
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  tasks         Task[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
}

enum TaskPriority {
  LOW
  LESS_URGENT
  MEDIUM
  HIGH
  URGENT
}

enum TaskScheduleType {
  NONE
  SPECIFIC_DATE
  DAY_OF_WEEK
}

model Task {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  description       String?
  remarks           String?
  assignedTo        String           @db.ObjectId
  employee          Employee         @relation(fields: [assignedTo], references: [id])
  assigneeIds       String[]         @db.ObjectId
  projectId         String?          @db.ObjectId
  project           Project?         @relation(fields: [projectId], references: [id])
  projectHeadId     String?          @db.ObjectId
  assignedBy        String?          @db.ObjectId
  isSelfTask        Boolean          @default(false)
  dueDate           DateTime?
  status            TaskStatus       @default(TODO)
  priority          TaskPriority     @default(MEDIUM)
  workDonePercent   Int              @default(0)
  extraDescriptions Json?
  reminderDates     Json?
  reminderWeekdays  Json?
  scheduleType      TaskScheduleType @default(NONE)
  scheduledDate     DateTime?
  scheduledWeekday  String?
  tags              Json?
  completedAt       DateTime?
  approvalStatus    String?
  tenantId          String?          @db.ObjectId
  tenant            Tenant?          @relation(fields: [tenantId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Asset {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  type          String
  serialNumber  String
  brand         String
  model         String
  status        String            @default("Available")
  condition     String            @default("New")
  purchasedOn   String
  warrantyUntil String?
  notes         String?
  tenantId      String?           @db.ObjectId
  tenant        Tenant?           @relation(fields: [tenantId], references: [id])
  allocations   AssetAllocation[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([tenantId, serialNumber])
}

model AssetAllocation {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  assetId           String    @db.ObjectId
  asset             Asset     @relation(fields: [assetId], references: [id])
  employeeId        String    @db.ObjectId
  employee          Employee  @relation(fields: [employeeId], references: [id])
  issuedOn          String
  expectedReturn    String?
  returnedOn        String?
  conditionOnIssue  String
  conditionOnReturn String?
  issuedBy          String
  notes             String?
  status            String    @default("Active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Document {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  type       String
  category   String
  employeeId String?   @db.ObjectId
  employee   Employee? @relation(fields: [employeeId], references: [id])
  uploadedBy String
  uploadedAt DateTime  @default(now())
  size       String
  url        String
  status     String    @default("Active")
  tags       String[]
  tenantId   String?   @db.ObjectId
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model PerformanceReview {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  employeeId        String             @db.ObjectId
  employee          Employee           @relation(fields: [employeeId], references: [id])
  cycle             String
  cycleType         String
  metrics           Metrics
  insights          Insights
  selfAssessment    SelfAssessment?
  managerAssessment ManagerAssessment?
  status            String             @default("Pending Self Review")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

type Metrics {
  taskScore       Float
  attendanceScore Float
  leaveScore      Float
  managerScore    Float
  finalScore      Float
  category        String
  breakdown       Json?
}

type Insights {
  strengths       String[]
  weaknesses      String[]
  recommendations String[]
}

type SelfAssessment {
  submittedAt String
  rating      Float
  comments    String
}

type ManagerAssessment {
  submittedAt String
  managerId   String
  rating      Float
  feedback    String
}

enum OnboardingSource {
  MANUAL
  BULK_IMPORT
  EXTERNAL_ATS
}

enum SalaryAnchorType {
  ANNUAL_CTC
  MONTHLY_CTC
  MONTHLY_GROSS
}

enum SalaryComponentSection {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum SalaryCalcType {
  PERCENT_OF_ANCHOR
  PERCENT_OF_COMPONENT
  PERCENT_OF_GROSS
  FIXED
  BALANCE_OF_GROSS
}

type SalaryComponentRule {
  code     String
  name     String
  section  SalaryComponentSection
  calcType SalaryCalcType
  value    Float
  baseRef  String?
  cap      Float?
  order    Int
}

model PayrollComplianceProfile {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String                @db.ObjectId
  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  name         String
  country      String
  region       String?
  city         String?
  locality     String?
  currencyCode String                @default("INR")
  anchorType   SalaryAnchorType      @default(ANNUAL_CTC)
  components   SalaryComponentRule[]
  documentUrl  String?
  isDefault    Boolean               @default(false)
  compensations EmployeeCompensation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model EmployeeCompensation {
  id                  String                  @id @default(auto()) @map("_id") @db.ObjectId
  tenantId            String                  @db.ObjectId
  tenant              Tenant                  @relation(fields: [tenantId], references: [id])
  employeeId          String?                 @unique @db.ObjectId
  employee            Employee?               @relation(fields: [employeeId], references: [id])
  onboardingHireId    String?                 @unique @db.ObjectId
  onboardingHire      OnboardingHire?         @relation(fields: [onboardingHireId], references: [id])
  complianceProfileId String                  @db.ObjectId
  complianceProfile   PayrollComplianceProfile @relation(fields: [complianceProfileId], references: [id])
  anchorType          SalaryAnchorType
  anchorValue         Float
  currencyCode        String                  @default("INR")
  componentOverrides  Json?
  computedSnapshot    Json
  effectiveFrom       DateTime                @default(now())
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

model OnboardingHire {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String?          @db.ObjectId
  tenant     Tenant?          @relation(fields: [tenantId], references: [id])
  name       String
  role       String
  department String
  email      String?
  phone      String?
  country    String?
  region     String?
  city       String?
  locality   String?
  source     OnboardingSource @default(MANUAL)
  employeeId String?          @db.ObjectId
  userId     String?          @db.ObjectId
  progress   Int              @default(0)
  joinDate   String
  status     String           @default("Pending")
  tasks      OnboardingTask[]
  compensation EmployeeCompensation?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

type OnboardingTask {
  label String
  done  Boolean @default(false)
}

model PolicyDocument {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String               @db.ObjectId
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  title           String
  category        PolicyCategory       @default(LEAVE_ATTENDANCE)
  fileName        String?
  fileUrl         String?
  mimeType        String?
  fileSize        Int?
  extractedText   String?
  draftRules      Json?
  status          PolicyDocumentStatus @default(DRAFT)
  uploadedByUserId String?             @db.ObjectId
  versions        PolicyVersion[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model PolicyVersion {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  policyDocumentId String         @db.ObjectId
  policyDocument   PolicyDocument @relation(fields: [policyDocumentId], references: [id])
  tenantId         String         @db.ObjectId
  version          Int
  effectiveFrom    DateTime       @default(now())
  publishedAt      DateTime?
  publishedByUserId String?       @db.ObjectId
  rules            Json
  isActive         Boolean        @default(false)
  acknowledgments  PolicyAcknowledgment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model PolicyAcknowledgment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  policyVersionId String        @db.ObjectId
  policyVersion   PolicyVersion @relation(fields: [policyVersionId], references: [id])
  userId          String        @db.ObjectId
  acknowledgedAt  DateTime      @default(now())
}

model SeparationRequest {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  tenantId             String             @db.ObjectId
  tenant               Tenant             @relation(fields: [tenantId], references: [id])
  employeeId           String             @db.ObjectId
  employee             Employee           @relation(fields: [employeeId], references: [id])
  requesterUserId      String?            @db.ObjectId
  orgUnitId            String?            @db.ObjectId
  exitType             SeparationExitType @default(RESIGNATION)
  reason               String
  resignationLetterUrl String?
  submittedAt          DateTime?
  requestedLWD         DateTime
  approvedLWD          DateTime?
  noticePeriodDays     Int
  noticeShortfallDays  Int?
  buyoutApproved       Boolean            @default(false)
  status               SeparationStatus   @default(DRAFT)
  managerRemark        String?
  hrRemark             String?
  checklist            Json?
  completedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

enum FieldVisitStatus {
  PENDING
  VERIFIED
  MISSED
  SKIPPED
}

model FieldVisitAssignment {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  dateKey        String
  employeeId     String           @db.ObjectId
  employee       Employee         @relation(fields: [employeeId], references: [id])
  locationId     String           @db.ObjectId
  location       WorkLocation     @relation(fields: [locationId], references: [id])
  sequence       Int              @default(0)
  plannedTime    String?
  status         FieldVisitStatus @default(PENDING)
  verifiedAt     DateTime?
  verifyLat      Float?
  verifyLng      Float?
  distanceMeters Float?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model FieldVisitLocationPing {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id])
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())
}

enum ChangeRequestCategory {
  PERSONAL_INFO
  JOB_ROLE
  BANK_DETAILS
  STATUTORY
  CUSTOM_FIELDS
  BENEFICIARIES
}

enum EmploymentChangeType {
  INITIAL_HIRE
  PROMOTION
  TRANSFER
  REPORTING_CHANGE
  CONFIRMATION
  REVISION
}

model EmployeeChangeRequest {
  id                  String                 @id @default(auto()) @map("_id") @db.ObjectId
  tenantId            String                 @db.ObjectId
  tenant              Tenant                 @relation(fields: [tenantId], references: [id])
  employeeId          String                 @db.ObjectId
  employee            Employee               @relation(fields: [employeeId], references: [id])
  requestedByUserId   String                 @db.ObjectId
  category            ChangeRequestCategory  @default(JOB_ROLE)
  effectiveDate       DateTime               @default(now())
  reason              String
  changes             Json                   // Map of { fieldName: { oldValue: any, newValue: any } }
  status              ApprovalRequestStatus  @default(PENDING)
  reviewedByUserId    String?                @db.ObjectId
  reviewedAt          DateTime?
  reviewRemark        String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

model EmploymentHistory {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String               @db.ObjectId
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  employeeId      String               @db.ObjectId
  employee        Employee             @relation(fields: [employeeId], references: [id])
  changeType      EmploymentChangeType @default(INITIAL_HIRE)
  effectiveDate   DateTime             @default(now())
  endDate         DateTime?
  designation     String
  department      String
  orgUnitId       String?              @db.ObjectId
  orgUnitName     String?
  locationId      String?              @db.ObjectId
  locationName    String?
  reportsToUserId String?              @db.ObjectId
  reportsToName   String?
  remarks         String?
  changeRequestId String?              @db.ObjectId
  recordedBy      String?              @db.ObjectId
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
  TEXTAREA
}

enum CustomFieldSection {
  PERSONAL
  WORK_DETAILS
  COMPLIANCE_KYC
  OTHER
}

model CustomFieldDefinition {
