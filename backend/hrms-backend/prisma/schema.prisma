// ─── Compensation Planning & Increment Cycles ──────────────────────────

model CompensationCycle {
  id                 String                           @id @default(auto()) @map("_id") @db.ObjectId
  tenantId           String                           @db.ObjectId
  tenant             Tenant                           @relation(fields: [tenantId], references: [id])
  name               String                           // e.g. "Annual Appraisal & Increment FY2026-27"
  code               String                           // e.g. "INC-2026-ANNUAL"
  fiscalYear         String                           // e.g. "2026-2027"
  effectiveDate      DateTime                         // When hike takes effect
  status             String                           @default("PLANNING") // "PLANNING", "IN_PROGRESS", "REVIEW", "APPROVED", "APPLIED", "CLOSED"
  totalBudgetAmount  Float                            // Monetary increment budget pool (e.g. ₹50,00,000)
  currency           String                           @default("INR")
  overallHikePercent Float                            @default(10.0) // 10% average hike guideline
  ratingMatrix       Json?                            // Matrix: rating x compaRatio -> recommended hike %
  departmentPools    DepartmentBudgetPool[]
  recommendations    EmployeeIncrementRecommendation[]
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model DepartmentBudgetPool {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  tenantId           String            @db.ObjectId
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  cycleId            String            @db.ObjectId
  cycle              CompensationCycle @relation(fields: [cycleId], references: [id])
  department         String            // "Engineering", "Sales", "Human Resources", etc.
  allocatedBudget    Float             // Department's allocated pool in currency
  spentBudget        Float             @default(0) // Total recommended/approved hike amount
  eligibleHeadcount  Int               @default(0)
  averageHikePercent Float             @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([cycleId, department])
  @@index([tenantId, department])
}

model EmployeeIncrementRecommendation {
  id                    String            @id @default(auto()) @map("_id") @db.ObjectId
  tenantId              String            @db.ObjectId
  cycleId               String            @db.ObjectId
  cycle                 CompensationCycle @relation(fields: [cycleId], references: [id])
  employeeId            String            @db.ObjectId
  employee              Employee          @relation(fields: [employeeId], references: [id])
  currentCtc            Float
  gradeMidpoint         Float?            // Reference salary for Grade midpoint
  compaRatio            Float?            // (currentCtc / gradeMidpoint) * 100
  performanceRating     Float?            // 1.0 to 5.0
  recommendedPercent    Float             // Recommended % hike
  recommendedHikeAmount Float             // Recommended absolute hike in currency
  newProposedCtc        Float             // currentCtc + recommendedHikeAmount
  managerNotes          String?
  status                String            @default("SUBMITTED") // "DRAFT", "SUBMITTED", "APPROVED", "REJECTED", "APPLIED"
  hrApprovedByUserId    String?           @db.ObjectId
  appliedAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([cycleId, employeeId])
  @@index([tenantId, cycleId, status])
}

// ─── Succession Planning, Skill Matrix, 9-Box ─────────────────────────

model TalentAssessment {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId         String   @db.ObjectId
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  employeeId       String   @db.ObjectId
  employee         Employee @relation(fields: [employeeId], references: [id])
  performanceLevel Int      // 1 (Low), 2 (Medium), 3 (High)
  potentialLevel   Int      // 1 (Low), 2 (Medium), 3 (High)
  nineBoxGrid      String   // "STAR", "HIGH_PERFORMER", "CORE_PLAYER", "RISING_STAR", "SOLID_PERFORMER", "EFFECTIVE", "ROUGH_DIAMOND", "INCONSISTENT", "RISK"
  flightRisk       String   @default("LOW") // "LOW", "MEDIUM", "HIGH"
  impactOfLoss     String   @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  strengths        String[]
  developmentAreas String[]
  assessedYear     String   @default("2026")
  assessedByUserId String?  @db.ObjectId
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, nineBoxGrid])
  @@index([tenantId, employeeId])
}

model SkillDefinition {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  tenantId         String          @db.ObjectId
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  code             String          // "SKILL-SYS-ARCH", "SKILL-KUBERNETES", "SKILL-FIN-AUDIT"
  name             String
  category         String          // "TECHNICAL", "LEADERSHIP", "DOMAIN", "COMPLIANCE"
