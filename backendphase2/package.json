{
  "name": "saas-recruitment-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for SAAS Recruitment Platform",
  "main": "src/server.js",
  "scripts": {
    "preinstall": "node -e \"process.exit(0)\"",
    "clean": "rimraf node_modules && npm install",
    "dev": "nodemon --exec tsx --ext ts,js src/server.js",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "start": "tsx src/server.js",
    "postinstall": "prisma generate || true",
    "prisma:generate": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "create:super-admin": "node scripts/create-super-admin.js",
    "seed:hq-admin": "node scripts/seed-hq-platform-admin.js",
    "create:role-users": "node scripts/create-role-users.js",
    "disable-password-reset": "node scripts/disable-password-reset.js",
    "seed:team": "pnpm db:seed",
    "migrate:external-urls-to-s3": "node scripts/migrate-external-urls-to-s3.mjs",
    "purge:bulkcv-emails": "node scripts/purge-bulkcv-email-candidates.js",
    "purge:bulkcv-emails:execute": "node scripts/purge-bulkcv-email-candidates.js --execute",
    "normalize:bulkcv-emails": "node scripts/normalize-bulkcv-emails.js",
    "normalize:bulkcv-emails:execute": "node scripts/normalize-bulkcv-emails.js --execute"
  },
  "keywords": [
    "recruitment",
    "saas",
    "api",
    "express",
    "prisma",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@azure/identity": "^4.8.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/client": "^5.19.1",
    "adm-zip": "0.5.16",
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^148.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "mongodb": "^7.1.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "multer-s3": "^3.0.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.10.0",
    "openai": "^4.86.1",
    "pdf-parse": "^2.4.5",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "4.10.38",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pngjs": "^7.0.0",
    "resend": "^4.0.0",
    "socket.io": "^4.8.3",
    "tesseract.js": "^5.1.0",
    "twilio": "^5.4.0",
    "uuid": "^13.0.0",
    "word-extractor": "1.0.4",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "nodemon": "^3.1.14",
    "pdf-lib": "^1.17.1",
    "prisma": "^5.19.1",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
