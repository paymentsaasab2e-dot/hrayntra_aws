// ── TASKS & ACTIVITIES ──
// Serves: Task&Activites

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  AWAITING_APPROVAL
  DONE
  CANCELLED
}

enum LinkedEntityType {
  CANDIDATE
  JOB
  CLIENT
  INTERVIEW
  INTERNAL
  TEAM_REQUEST
}

model Task {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  description      String?
  dueDate          DateTime
  dueTime          String? // Time component (e.g., "10:00 AM")
  priority         TaskPriority      @default(MEDIUM)
  status           TaskStatus        @default(PENDING)
  taskType         String? // Call, Email, Interview, Follow-up, Meeting, Note
  assignedToId     String            @db.ObjectId
  createdById      String            @db.ObjectId
  linkedEntityType LinkedEntityType?
  linkedEntityId   String?
  // Extended fields from frontend
  reminder         String? // Reminder setting (e.g., "15min", "1hr", "1day")
  reminderChannel  String? // notification, email, whatsapp
  attachments      String[] // Array of attachment URLs/names
  notifyAssignee   Boolean           @default(true)
  notes            String[] // Array of notes
  /// Users who retain visibility after reassignment (creator, past assignees, delegators).
  participantIds   String[]          @default([])
  completionRequestedById String?     @db.ObjectId
  completionRequestedAt   DateTime?
  completionApproverId    String?     @db.ObjectId
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  assignedTo User       @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy  User       @relation("TaskCreator", fields: [createdById], references: [id])
  files      TaskFile[] // Task files/attachments

  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

