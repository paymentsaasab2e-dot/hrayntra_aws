// ── LEAD ──
// Serves: leads

enum LeadStatus {
  New
  Contacted
  Qualified
  Converted
  Lost
}

enum LeadSource {
  Website
  LinkedIn
  Email
  Referral
  Campaign
}

enum LeadType {
  Company
  Individual
  Referral
}

enum Priority {
  High
  Medium
  Low
}

model Lead {
  id                     String     @id @default(auto()) @map("_id") @db.ObjectId
  // Primary fields matching frontend
  contactName            String?
  companyName            String?
  contactPerson          String?
  directorName           String?
  /// e.g. Mr, Mrs, Dr — shown with director / contact name
  directorSalutation     String?
  email                  String?
  phone                  String?
  /// Additional contact emails (first entry mirrors `email` for legacy integrations).
  emails                 String[]   @default([])
  /// Additional contact phone numbers (first entry mirrors `phone`).
  phones                 String[]   @default([])
  type                   LeadType   @default(Company)
  /// When null/omitted, UI shows no source badge (imports with no Source column).
  source                 LeadSource?
  status                 String     @default("New")
  priority               Priority   @default(Medium)
  interestedNeeds        String?
  servicesNeeded         String?
  notes                  String?
  expectedBusinessValue  String?
  // Extended company fields
  industry               String?
  sector                 String?
  companySize            String?
  teamName               String?
  website                String?
  companyLinks           String[]   @default([])
  linkedIn               String?
  location               String?
  // Extended contact fields
  designation            String?
  /// Optional team-member contact (when a team name is set on the lead).
  teamMemberDesignation  String?
  teamMemberEmail        String?
  teamMemberPhone        String?
  country                String?
  city                   String?
  /// Smart-location autofill (Nominatim/OpenStreetMap). Optional metadata.
  state                  String?
  latitude               Float?
  longitude              Float?
  // Lead management fields
  campaignName           String?
  campaignLink           String?
  referralName           String?
  sourceWebsiteUrl       String?
  sourceLinkedInUrl      String?
  sourceEmail            String?
  otherDetails           Json?
  lastFollowUp           DateTime?
  nextFollowUp           DateTime?
  lostReason             String? // Reason when marked as lost
  // Agreements & Terms uploaded against the lead (single primary doc).
  // Detailed multi-document history continues to live in LeadFile.
  agreementsFileName              String?
  agreementsFileUrl               String?
  agreementsUploadedAt            DateTime?
  agreementTotalPayment           String? // Professional fees
  agreementLevel                  String?
  agreementServiceChargePercent   String?
  agreementContractValidity       String?
  agreementContractStartDate      String?
  agreementContractEndDate        String?
  agreementTimePeriod             String? // Payment terms
  agreementAdvancePaymentPercent  String?
  agreementFreeReplacementValue   Int?    // legacy
  agreementFreeReplacementUnit    String? // legacy MONTHS | DAYS
  // Relations
  assignedToId           String?    @db.ObjectId
  /// Multi-assignee support — full list (assignedToId stays the primary owner).
  assignedToIds          String[]   @db.ObjectId
  convertedToClientId    String?    @db.ObjectId
  convertedToCandidateId String?    @db.ObjectId
  convertedAt            DateTime?
  // Soft-delete / Recycle Bin metadata. Hard delete is replaced with isDeleted=true so the
  // lead can be restored from the Recycle Bin page. Stored as nullable Boolean because
  // legacy MongoDB documents created before this field existed don't carry it — Prisma
  // would otherwise crash with "Argument `isDeleted` is missing" when deserializing them.
  // Treat null/undefined as "not deleted" in queries (use { isDeleted: { not: true } }).
  isDeleted              Boolean?   @default(false)
  deletedAt              DateTime?
  deletedBy              String?
  orgId                  String?
  createdBy              String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  // Relations
  assignedTo User?      @relation(fields: [assignedToId], references: [id])
  client     Client?    @relation(fields: [convertedToClientId], references: [id])
  noteList   LeadNote[]
  files      LeadFile[]

  @@index([status])
  @@index([orgId])
  @@index([orgId, isDeleted])
  @@index([orgId, email])
  @@index([assignedToId])
  @@index([source])
  @@index([type])
  @@map("leads")
}

/// Shareable public intake form — one active row per tenant DB (token in the URL + ?tenantDbName=).
model LeadIntakeForm {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  publicToken String   @unique
  isActive    Boolean  @default(true)
  title       String   @default("Add Lead")
  createdAt   DateTime @default(now())
