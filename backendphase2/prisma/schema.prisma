  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([leadId])
  @@index([requestedById])
  @@index([approverUserId])
  @@index([status])
  @@index([createdAt])
  @@map("lead_conversion_requests")
}

model Commission {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  userId           String           @db.ObjectId
  placementId      String // Changed from String? to String as per requirements
  commissionAmount Float
  commissionPct    Float
  status           CommissionStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("commissions")
}

// ── ARIA SYSTEM OPERATOR ──
// Serves: ai assistant undo / persistent memory

model Undo {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  actionId    String   @unique
  userId      String   @db.ObjectId
  module      String
  action      String // DELETE | UPDATE | RESTORE | BULK_DELETE
  endpoint    String
  method      String
  targetIds   String[]
  reverseData Json?
  uiReverse   Json?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("aria_undo_stack")
}

enum SessionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  REVOKED
}

enum SessionTransferStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

/// Single active login session per user (enterprise session control).
model ActiveSession {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  userId           String        @db.ObjectId
  sessionId        String        @unique
  jwtTokenHash     String?
  refreshTokenHash String?
  deviceId         String?
  browserInfo      String?
  operatingSystem  String?
  deviceType       String?
  ipAddress        String?
  location         String?
  loginTime        DateTime      @default(now())
  lastActivity     DateTime      @default(now())
  sessionStatus    SessionStatus @default(ACTIVE)
  socketId         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionStatus])
  @@index([lastActivity])
  @@map("active_sessions")
}

model SessionTransferRequest {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  userId           String                @db.ObjectId
  requestId        String                @unique
  status           SessionTransferStatus @default(PENDING)
  challengerDevice Json?
  challengerIp     String?
  expiresAt        DateTime
  resolvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("session_transfer_requests")
}

model SessionAuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  action     String
  deviceInfo String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("session_audit_logs")
}

/// Phase 1 candidate snapshots in Mongo DB `candidatecommon` (separate connection URL).
model CandidateCommon {
  id                      String    @id @map("_id") @db.ObjectId
  candidateId             String    @unique @db.ObjectId
  isVerified              Boolean   @default(false)
  firstName               String?
  lastName                String?
  email                   String?
  phone                   String?
  linkedIn                String?
  resumeUrl               String?
  skills                  String[]  @default([])
  recruiterSkills         String[]  @default([])
  experience              Int?
  experienceYears         Int?
  currentTitle            String?
  currentCompany          String?
  location                String?
  city                    String?
  country                 String?
  designation             String?
  cvSummary               String?
  notes                   String?
  recruiterNotes          String?
  certifications          String[]  @default([])
  certificationsList      String[]  @default([])
  cvEducationEntries      Json?
  cvWorkExperienceEntries Json?
  cvPortfolioLinks        Json?
  profileSnapshot         Json?
  profilePhotoUrl         String?
  gender                  String?
  middleName              String?
  whatsappNumber          String?
  addressLine             String?
  state                   String?
  zipCode                 String?
  dateOfBirth             String?
  languagesDetail         Json?
  recruiterLanguages      String[]  @default([])
  careerPreferences       Json?
  resumeFileName          String?
  resumeMimeType          String?
  resumeAtsScore          Int?
  noticePeriod            String?
  availability            String?
  assignedJobs            String[]  @default([])
  matchJobIds             String[]  @default([])
  stage                   String?
  source                  String?   @default("phase1")
  lastLoginAt             DateTime?
  syncedAt                DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([assignedJobs])
  @@index([matchJobIds])
  @@index([isVerified])
  @@map("candidate_commons")
}

model UserDashboardLayout {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  widgets   Json     @default("[]")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_dashboard_layouts")
}

// Job portal LMS events (shared jobportal DB — written by HQ / Phase 2, read by Phase 1).
model LmsEvent {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  description      String
  location         String?
  sections         Json?
  type             String
  hostName         String?
  hostAvatar       String?
  scheduledAt      DateTime
  durationMinutes  Int      @default(0)
  mode             String
  meetingUrl       String?
  capacity         Int?
  tags             String[] @default([])
  isPublished      Boolean  @default(false)
  status           String   @default("active")
  media            Json?
  createdById      String?
  createdByEmail   String?
  createdByName    String?
  source           String?
  tenantDbName     String?
  accessType       String   @default("free")
  tokenCost        Int      @default(0)
  ctaLabel         String   @default("Join")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  registrations LmsEventRegistration[]

  @@map("lms_events")
  @@index([createdById, source])
  @@index([isPublished, scheduledAt])
}

model LmsEventRegistration {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  eventId      String    @db.ObjectId
  registeredAt DateTime  @default(now())
  attended     Boolean   @default(false)
  tokensSpent  Int       @default(0)
  paidAt       DateTime?
  payoutStatus String?

  event LmsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("lms_event_registrations")
}

// Phase 2 CRM behaviour snapshots — one latest payload per tenant user (7d rollup + triggers).
model TenantBehaviorSnapshot {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @unique
  userName   String?
  payload    Json
  capturedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("tenant_behavior_snapshots")
  @@index([capturedAt])
}
