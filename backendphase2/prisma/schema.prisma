enum MatchStatus {
  SUGGESTED
  REVIEWED
  SHORTLISTED
  REJECTED
}

model Match {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  candidateId String      @db.ObjectId
  jobId       String?     @db.ObjectId
  score       Float
  status      MatchStatus @default(SUGGESTED)
