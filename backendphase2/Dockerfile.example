# Copy to backendphase2/Dockerfile on AWS (not tracked by git).
#
# REQUIRED: copy prisma/ BEFORE npm install (fixes "schema.prisma: file not found")
#
#   cp Dockerfile.example Dockerfile

FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    graphicsmagick \
    ghostscript \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY prisma ./prisma

RUN npm config set legacy-peer-deps true
# postinstall runs prisma generate when prisma/ is present (no scripts/ needed yet)
RUN npm install --legacy-peer-deps

COPY . .

RUN npx prisma generate

ENV NODE_ENV=production
ENV RUNNING_IN_DOCKER=1
EXPOSE 5001

CMD ["node", "src/server.js"]
