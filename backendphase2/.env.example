# Copy to .env and fill in values.

# ==============================
# EMAIL (Resend) — per-mailbox FROM addresses
# ==============================
RESEND_API_KEY=
# Fallback when a trigger has no mapped mailbox
RESEND_FROM_EMAIL=operations@hryantra.com
EMAIL_FROM_AUTH=auth@hryantra.com
EMAIL_FROM_WELCOME=welcome@hryantra.com
EMAIL_FROM_TEAM=team@hryantra.com
EMAIL_FROM_OPERATIONS=operations@hryantra.com
EMAIL_FROM_CAREERS=careers@hryantra.com
EMAIL_FROM_EMPLOYERS=employers@hryantra.com
EMAIL_FROM_BILLING=billing@hryantra.com

# ==============================
# AI / LLM — OpenAI gpt-4.1 primary, Mistral fallback
# ==============================
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_ASSISTANT_MODEL=gpt-4.1

# Used when OpenAI fails or quota cooldown (429)
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

# Bulk CV (ZIP / folder sessions)
BULK_CV_MAX_FILES=2000
BULK_CV_MAX_ZIP_BYTES=2147483648
# CV parsing: keep stored text in the CV language (Spanish/French/English…) — default on.
CV_PARSE_PRESERVE_SOURCE_LANGUAGE=true
# Requires OPENAI_API_KEY (or MISTRAL_API_KEY as fallback) for best results on non-English resumes.

# ==============================
# Single active session (enterprise login)
# ==============================
SINGLE_ACTIVE_SESSION_ENABLED=true
SESSION_INACTIVITY_MS=1800000
SESSION_INACTIVITY_WARNING_MS=120000
SESSION_TRANSFER_TTL_MS=300000
# Optional: separate secret for duplicate-login email links (defaults to JWT access secret)
# SESSION_TRANSFER_EMAIL_SECRET=
# Public API URL (must include http:// or https://)
BACKEND_PUBLIC_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3001
# Public HTTPS URL for duplicate-login email buttons (required for Gmail; use ngrok in local dev)
# SESSION_TRANSFER_EMAIL_PUBLIC_URL=https://employers.yourdomain.com
# REDIS_URL=redis://127.0.0.1:6379
