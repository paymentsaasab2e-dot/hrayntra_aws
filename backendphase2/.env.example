# Copy to .env and fill in values.

# ==============================
# AI / LLM — OpenAI gpt-4.1 primary, Mistral fallback
# ==============================
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_ASSISTANT_MODEL=gpt-4.1

# Used when OpenAI fails or quota cooldown (429)
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

# Bulk CV (ZIP / folder sessions)
BULK_CV_MAX_FILES=2000
BULK_CV_MAX_ZIP_BYTES=2147483648

# ==============================
# Single active session (enterprise login)
# ==============================
SINGLE_ACTIVE_SESSION_ENABLED=true
SESSION_INACTIVITY_MS=300000
SESSION_INACTIVITY_WARNING_MS=60000
SESSION_TRANSFER_TTL_MS=300000
# REDIS_URL=redis://127.0.0.1:6379
